rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Public community posts and threaded discussions
    match /community_posts/{postId} {
      // Anyone worldwide can read posts
      allow read: if true;

      // Anyone can create a post if valid data is provided
      allow create: if request.resource.data.authorName is string 
                    && request.resource.data.authorName.size() <= 100
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 2000
                    && request.resource.data.category in ["General", "Mod Ideas", "SMP Server", "Fan Art", "Video Feedback"]
                    && request.resource.data.createdAt is number;

      // Anyone can update (for adding replies, liking, or pinning)
      allow update: if request.resource.data.content is string
                    && request.resource.data.content.size() <= 2000;

      // Auto-delete cleanup: Only allow deleting UNPINNED messages older than 35 days (3024000000 ms)
      // Pinned messages (isPinned == true) are protected and can never be deleted
      allow delete: if resource.data.isPinned != true
                    && resource.data.createdAt is number
                    && request.time.toMillis() >= resource.data.createdAt + 3024000000;
    }
  }
}
